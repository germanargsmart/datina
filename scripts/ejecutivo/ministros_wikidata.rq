#              OPTIONAL { ?birth wdt:P17 ?birthCountry }
#              OPTIONAL { ?birth wdt:P131+ ?anc . OPTIONAL { ?anc wdt:P31 ?ancType } } }
#   OPTIONAL { ?person wdt:P102 ?party }
#   SERVICE wikibase:label { bd:serviceParam wikibase:language "es,en". }
